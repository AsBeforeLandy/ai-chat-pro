# AI API Configuration
# Copy this file to .env.local and fill in your API keys

# OpenAI-compatible API (DeepSeek, OpenAI, 通义千问, etc.)
API_KEY=your_api_key_here
API_BASE_URL=https://api.openai.com/v1
API_MODEL=gpt-5.5

# Examples for other providers:
# DeepSeek:  API_BASE_URL=https://api.deepseek.com/v1  API_MODEL=deepseek-chat
# 通义千问:   API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  API_MODEL=qwen-plus
